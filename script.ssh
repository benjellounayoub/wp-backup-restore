#!/bin/bash
set -euo pipefail

# === Menu ===
echo "Select the project to back up:"
echo "1) domain1.com"
echo "2) domain2.com"
echo "3) domain3.ca"
echo "4) domain4.ca"
echo "5) domain5.ca"
echo "6) domain6.com"
read -rp "Enter number [1-6]: " CHOICE

case "$CHOICE" in
  1) DOMAIN="domain1.com" ;;
  2) DOMAIN="domain2.com" ;;
  3) DOMAIN="domain3.ca" ;;
  4) DOMAIN="domain4.ca" ;;
  5) DOMAIN="domain5.ca" ;;
  6) DOMAIN="domain6.com" ;;
  *) echo "Invalid choice"; exit 1 ;;
esac

# === Paths & timestamps ===
WEBROOT="/var/www/html/${DOMAIN}"
NGINX_CONF="/etc/nginx/sites-available/${DOMAIN}"
DATE_DIR="$(date +%Y-%m-%d)"             # safer (no spaces)
TIMESTAMP="$(date +%Y%m%d%H%M%S)"
BACKUP_DIR="/var/www/save/${DOMAIN}/${DATE_DIR}"

# === Ensure backup dir exists ===
sudo mkdir -p "$BACKUP_DIR"

# === Find DB creds from WordPress wp-config.php ===
WP_CONFIG="${WEBROOT}/wp-config.php"
if [[ ! -f "$WP_CONFIG" ]]; then
  echo "Error: wp-config.php not found at $WP_CONFIG"
  exit 1
fi

# Parse DB_NAME and DB_USER from wp-config.php
DB_NAME="$(grep -E "define\(\s*'DB_NAME'" "$WP_CONFIG" | sed "s/.*'DB_NAME',\s*'\([^']*\)'.*/\1/")"
DB_USER="$(grep -E "define\(\s*'DB_USER'" "$WP_CONFIG" | sed "s/.*'DB_USER',\s*'\([^']*\)'.*/\1/")"

# Fallback prompt if parsing fails
if [[ -z "${DB_NAME}" ]]; then
  read -rp "Couldn't detect DB_NAME. Enter DB name: " DB_NAME
fi
if [[ -z "${DB_USER}" ]]; then
  read -rp "Couldn't detect DB_USER. Enter DB user: " DB_USER
fi

echo "Backing up domain: $DOMAIN"
echo "Webroot: $WEBROOT"
echo "Nginx conf: $NGINX_CONF"
echo "DB_USER: $DB_USER"
echo "DB_NAME: $DB_NAME"
echo

# === Backup website files (compressed) ===
sudo tar czf "${BACKUP_DIR}/${TIMESTAMP}_files.tar.gz" -C "/var/www/html" "${DOMAIN}"

# === Backup nginx site config ===
if [[ -f "$NGINX_CONF" ]]; then
  sudo cp "$NGINX_CONF" "$BACKUP_DIR/"
else
  echo "Warning: Nginx config not found at $NGINX_CONF (skipping)."
fi

# === Backup MariaDB database (compressed) ===
# Prompts securely for password
mysqldump -u "$DB_USER" -p "$DB_NAME" | gzip > "${BACKUP_DIR}/db_${TIMESTAMP}.sql.gz"

# === Summary ===
echo
echo "Backup completed:"
echo " - Files:   ${BACKUP_DIR}/${TIMESTAMP}_files.tar.gz"
echo " - Nginx:   ${BACKUP_DIR}/$(basename "$NGINX_CONF" 2>/dev/null || true)"
echo " - DB dump: ${BACKUP_DIR}/db_${TIMESTAMP}.sql.gz"
